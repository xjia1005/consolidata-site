# Illustrative private systemd EnvironmentFile. Never put actual values in Git.
# Keep /etc/consolidata-growth99/environment root-owned and service-group-readable
# (0640), with its directory 0750. This example cannot enable purchases.
CHECKUP_DATA_DIR=/var/lib/consolidata-growth99
CHECKUP_PUBLIC_ORIGIN=https://cdatats.com
CHECKUP_LIVE_ENABLED=0
# Pause only NEW checkout while retaining signed-payment handling and delivery.
CHECKUP_CHECKOUT_PAUSED=1
CHECKUP_STRIPE_SECRET_KEY=
CHECKUP_STRIPE_PRICE_ID=price_1UX4UORpzjXsSjtTi0POceqC
CHECKUP_STRIPE_WEBHOOK_SECRET=
CHECKUP_SMTP_HOST=
CHECKUP_SMTP_PORT=587
CHECKUP_SMTP_SECURITY=starttls
CHECKUP_SMTP_USERNAME=
CHECKUP_SMTP_PASSWORD=
CHECKUP_FROM_EMAIL=alvinj@consolidatats.com
